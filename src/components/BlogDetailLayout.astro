---
/**
 * BlogDetailLayout.astro
 * Blog detail page template, follows ServiceDetailLayout pattern
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './seo/Breadcrumb.astro';
import StructuredData from './seo/StructuredData.astro';
import '../styles/blog.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile.jpg';
import type { BlogPostResponse, BlogTag } from '@shared/contracts/api';
import {
  categoryLabels,
  categoryIcons,
  tagLabels,
  getPrimaryCategory,
  formatDate,
  transformBlogPost,
  sanitizeBlogContent,
} from '../lib/microcms';
import { siteMetadata } from '../lib/siteConfig';
import { loadProfile } from '../data/profileLoader';

interface Props {
  post: BlogPostResponse;
}

const { post } = Astro.props;
const siteUrl = siteMetadata.siteUrl;
const blog = transformBlogPost(post);
const category = getPrimaryCategory(blog.category);

// Breadcrumb
const breadcrumbItems = [
  { name: 'ブログ', href: '/blog/' },
  { name: blog.title, href: `/blog/${blog.slug || blog.id}/` },
];

// BlogPosting structured data
const articleData = {
  headline: blog.title,
  description: post.metaDescription || blog.excerpt || '',
  image: blog.thumbnail?.url || `${siteUrl}/自画像_シンプル背景.png`,
  datePublished: blog.publishedAt,
  dateModified: blog.updatedAt || blog.publishedAt,
  mainEntityOfPage: `${siteUrl}/blog/${blog.slug || blog.id}/`,
  articleSection: categoryLabels[category],
};

// Author data for E-E-A-T box
const profile = loadProfile();
const authorCredentials = profile.qualifications
  .filter((q) =>
    [
      '中小企業診断士(登録予定)',
      'ITストラテジスト',
      'E資格',
      '税理士科目合格（簿記論）',
    ].includes(q.name)
  )
  .map((q) => q.name);

// Category-specific credential context for E-E-A-T
import type { BlogCategory } from '@shared/contracts/api';
const categoryCredentialContext: Record<BlogCategory, string> = {
  kaizen: 'ITストラテジスト保有。システムと業務の両面から改善策を考えます。',
  ai: 'E資格保有。AIの技術的な限界も正直にお伝えできます。',
  data: 'データサイエンス3年の実務経験。数字の裏にある意味を読み解きます。',
  funding:
    '中小企業診断士（登録予定）。事業計画書の策定から申請まで経験しています。',
  accounting: '簿記論合格。帳簿の中身がわかる上でのアドバイスです。',
  management:
    '中小企業診断士（登録予定）。財務分析と経営戦略の両面から考えます。',
};
const credentialContext = categoryCredentialContext[category];

// Meta
const metaDescription =
  post.metaDescription ||
  blog.excerpt ||
  `${blog.title} - ししゃもカンパニーのブログ`;
const ogImage = post.ogImage?.url || blog.thumbnail?.url;
---

<Layout
  title={`${blog.title} | ブログ | ししゃもカンパニー`}
  description={metaDescription}
  ogType="article"
  ogImage={ogImage}
  publishedTime={blog.publishedAt}
  modifiedTime={blog.updatedAt}
  currentPage="blog"
>
  <!-- BlogPosting Structured Data -->
  <StructuredData type="BlogPosting" data={articleData} slot="head" />

  <!-- Article OGP: section and tags -->
  <meta
    property="article:section"
    content={categoryLabels[category]}
    slot="head"
  />
  {
    blog.tags &&
      blog.tags.map((tag) => (
        <meta
          property="article:tag"
          content={tagLabels[tag as BlogTag] || tag}
          slot="head"
        />
      ))
  }

  <!-- Breadcrumb -->
  <div class="blog-breadcrumb-wrapper">
    <Breadcrumb items={breadcrumbItems} separator="›" />
  </div>

  <!-- Article Header -->
  <header class="blog-header">
    <div class="blog-header__meta">
      <span class="blog-header__category">
        <Icon name={categoryIcons[category]} size={16} aria-hidden="true" />
        {categoryLabels[category]}
      </span>
      <span class="blog-header__date">
        <time datetime={blog.publishedAt}>{formatDate(blog.publishedAt)}</time>
        {
          blog.updatedAt && blog.updatedAt !== blog.publishedAt && (
            <span>（更新: {formatDate(blog.updatedAt)}）</span>
          )
        }
      </span>
    </div>
    <h1>{blog.title}</h1>
    {
      blog.tags && blog.tags.length > 0 && (
        <div class="blog-header__tags">
          {blog.tags.map((tag) => (
            <a href={`/blog/tag/${tag}/`} class="blog-header__tag">
              #{tagLabels[tag as BlogTag] || tag}
            </a>
          ))}
        </div>
      )
    }
  </header>

  <!-- Thumbnail -->
  {
    blog.thumbnail && (
      <div class="blog-thumbnail">
        <img
          src={`${blog.thumbnail.url}?w=960&h=540&fit=crop`}
          alt={blog.title}
          width="960"
          height="540"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <!-- Article Content (Rich Editor HTML) -->
  <article class="blog-content" set:html={sanitizeBlogContent(post.content)} />

  <!-- Related Blogs -->
  {
    post.relatedBlogs && post.relatedBlogs.length > 0 && (
      <section class="blog-related">
        <h2>関連記事</h2>
        <div class="blog-related__grid">
          {post.relatedBlogs.map((related) => {
            const relCat = getPrimaryCategory(related.category);
            return (
              <a
                href={`/blog/${related.slug || related.id}/`}
                class="blog-card"
              >
                <div class="blog-card__meta">
                  <span class="blog-card__category">
                    {categoryLabels[relCat]}
                  </span>
                  <time datetime={related.publishedAt}>
                    {formatDate(related.publishedAt)}
                  </time>
                </div>
                <h3 class="blog-card__title">{related.title}</h3>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- Blog Read Tracking -->
  <div
    id="blog-tracking-data"
    data-slug={blog.slug || blog.id}
    data-title={blog.title}
    data-category={categoryLabels[category]}
    hidden
  >
  </div>
  <script>
    import { trackBlogRead } from '../lib/analytics';
    const el = document.getElementById('blog-tracking-data');
    if (el) {
      trackBlogRead({
        blog_slug: el.dataset.slug || '',
        blog_title: el.dataset.title || '',
        blog_category: el.dataset.category || '',
      });
    }
  </script>

  <!-- Author Box (E-E-A-T) -->
  <aside class="blog-author-box">
    <div class="blog-author-box__inner">
      <Image
        src={profileImage}
        alt={profile.name}
        width={80}
        height={80}
        class="blog-author-box__avatar"
        loading="lazy"
      />
      <div class="blog-author-box__info">
        <div class="blog-author-box__name">
          <a href="/profile/">{profile.name}</a>
          <span class="blog-author-box__handle">@{profile['handle-name']}</span>
        </div>
        <div class="blog-author-box__credentials">
          {
            authorCredentials.map((cred) => (
              <span class="blog-author-box__badge">{cred}</span>
            ))
          }
        </div>
        {
          credentialContext && (
            <p class="blog-author-box__context">{credentialContext}</p>
          )
        }
        <p class="blog-author-box__bio">{profile.bio}</p>
        <a href="/profile/" class="blog-author-box__link"
          >プロフィールを見る →</a
        >
      </div>
    </div>
  </aside>

  <!-- CTA -->
  <section class="cta--dark">
    <h2>「うちの場合はどうすればいい？」<br />と思ったら</h2>
    <p>
      記事を読んで気になったこと、何でも聞いてください。<br
      />初回30分の無料相談で、状況に合わせた進め方を一緒に考えます。
    </p>
    <a href="/contact/" class="btn-primary" data-track-cta="blog-detail"
      >無料で相談する →</a
    >
  </section>
</Layout>
