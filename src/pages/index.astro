---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/images/profile.jpg';
import { Icon } from 'astro-icon/components';
import {
  getAllBlogPosts,
  categoryLabels,
  categoryIcons,
  getPrimaryCategory,
  formatDate,
  transformBlogPost,
} from '../lib/microcms';
import {
  problemItems,
  changeItems,
  evergreenBlogSlugs,
} from '../data/homepage';
import { socialLinks } from '../lib/siteConfig';
import { loadProfile } from '../data/profileLoader';
import StructuredData from '../components/seo/StructuredData.astro';
import XIcon from '../components/ui/XIcon.astro';
import '../styles/home.css';

const profileData = loadProfile();

const allPosts = await getAllBlogPosts();
const allTransformed = allPosts.map(transformBlogPost);

// Curated blog section: evergreen posts first, then latest (up to 3 total)
const evergreenPosts = evergreenBlogSlugs
  .map((slug) => allTransformed.find((p) => p.slug === slug))
  .filter(Boolean);
const remainingPosts = allTransformed.filter(
  (p) => !evergreenBlogSlugs.includes(p.slug)
);
const latestPosts =
  evergreenPosts.length > 0
    ? [...evergreenPosts, ...remainingPosts].slice(0, 3)
    : allTransformed.slice(0, 3);
---

<Layout
  title="ししゃもカンパニー - IT × 経営 × 財務"
  description="IT・会計・経営の3つの視点で、個人事業主・中小企業の経営課題を一緒に整理します。ししゃもカンパニー"
  currentPage="home"
>
  <StructuredData slot="head" type="WebSite" />

  <!-- 1. HERO -->
  <section class="hero hero--bg-full">
    <div class="hero-inner">
      <div class="hero-content">
        <h1 class="hero-title">
          踏み出す人の、<br />
          <span class="highlight">すぐ横にいる。</span>
        </h1>
        <p class="hero-desc">
          個人事業主・中小企業の「どこに聞けばいいかわからない」を、<br />
          IT・会計・経営の3つの視点で整理します。
        </p>
        <div class="hero-cta">
          <a href="/contact/" class="btn-primary" data-track-cta="hero"
            >まず話してみる <Icon name="ri:arrow-right-line" size={14} /></a
          >
          <a href="/services/" class="btn-secondary" data-track-cta="hero"
            >できることを見る</a
          >
        </div>
      </div>
      <div class="profile-card">
        <div class="profile-photo">
          <Image
            src={profileImage}
            alt="吉川昌宏"
            width={200}
            height={200}
            loading="eager"
          />
        </div>
        <div class="profile-social-list">
          <a
            href={socialLinks.x.url}
            target="_blank"
            rel="noopener noreferrer"
            class="profile-social-link"
            aria-label={socialLinks.x.label}
          >
            <XIcon size={13} />
            <span>{socialLinks.x.handle}</span>
          </a>
        </div>
        <div class="profile-name">吉川 昌宏</div>
        <div class="hero-badge">IT・会計・経営、まとめて聞ける</div>
        <div class="profile-title">
          エンジニア12年 / 会計事務所も経験 / 現役で両方やってます
        </div>
        <p class="profile-intro">
          「それ、誰に聞けばいいの？」をなくすのが仕事です。
        </p>
        <a href="/profile/" class="profile-detail-link">
          くわしいプロフィールを見る
          <Icon name="ri:arrow-right-line" size={12} />
        </a>
        <div class="profile-stats">
          <div class="stat-item">
            <div class="stat-value">12<span class="stat-unit">年</span></div>
            <div class="stat-label">システム開発</div>
            <div class="stat-tooltip">
              <ul>
                <li>Webアプリケーション開発</li>
                <li>業務システム設計・構築</li>
                <li>データベース設計・運用</li>
                <li>API開発・連携</li>
              </ul>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-value">1<span class="stat-unit">年</span></div>
            <div class="stat-label">会計事務所</div>
            <div class="stat-tooltip">
              <ul>
                <li>記帳代行・月次決算</li>
                <li>法人・個人の税務申告</li>
                <li>経営分析・財務アドバイス</li>
              </ul>
            </div>
          </div>
          <div class="stat-item">
            <div class="stat-value">6<span class="stat-unit">+</span></div>
            <div class="stat-label">国家資格</div>
            <div class="stat-tooltip">
              <ul>
                <li>中小企業診断士(登録予定)</li>
                <li>税理士科目合格(簿記論)</li>
                <li>ITストラテジスト</li>
                <li>データベーススペシャリスト</li>
                <li>応用情報技術者</li>
                <li>E資格（JDLA認定）</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 見えてきたこと -->
  <section class="section insight">
    <div class="container">
      <div class="insight-content">
        <p>
          データはあるのに活かされていない。使える制度が使われていない。<br />
          自分たちの強みに気づいていない。
        </p>
        <p>そういう会社が、想像よりずっと多かった。</p>
        <p>
          もったいないな、と思いました。<br />
          同時に、ここを一緒に考えられる人間がいたら、けっこう力になれるんじゃないかとも。
        </p>
      </div>
    </div>
  </section>

  <!-- 3. 困りごと -->
  <section class="section problems">
    <div class="container">
      <div class="section-header section-header--compact">
        <div class="section-label section-label--compact">For You</div>
        <h2 class="section-title section-title--compact">
          こんな状態なら、力になれます
        </h2>
        <p class="section-desc section-desc--compact">
          一つでも当てはまるなら、まず話を聞かせてください
        </p>
      </div>
      <div class="problem-list">
        {
          problemItems.map((item, index) => (
            <div
              class="problem-item"
              role="checkbox"
              aria-checked="false"
              tabindex="0"
              data-problem-index={index}
            >
              <Icon
                name="ri:checkbox-blank-line"
                class="problem-check problem-check--unchecked"
                size={20}
              />
              <Icon
                name="ri:checkbox-fill"
                class="problem-check problem-check--checked"
                size={20}
              />
              <span class="problem-text">{item.text}</span>
              <a
                href={item.guideLink}
                class="problem-guide"
                data-track="problem"
              >
                {item.guideTopic}{' '}
                <Icon name="ri:arrow-right-s-line" size={14} />
              </a>
            </div>
          ))
        }
      </div>
      <div class="problem-cta">
        <a
          href="/diagnostic/"
          class="btn-secondary"
          data-track-cta="diagnostic"
        >
          <Icon name="ri:stethoscope-line" size={14} />
          <span>何から始めればいいかわからない方へ</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 実際に起きた変化 -->
  <section class="section changes">
    <div class="container">
      <div class="section-header section-header--compact">
        <div class="section-label section-label--compact">Results</div>
        <h2 class="section-title section-title--compact">実際に起きた変化</h2>
        <p class="section-desc section-desc--compact">
          一緒に考えて動いた結果、こういう変化が起きた会社があります。
        </p>
      </div>
      <div class="changes-list">
        {
          changeItems.map((item) => (
            <div class="change-item">
              <div class="change-flow">
                <span class="change-before">{item.before}</span>
                <Icon
                  name="ri:arrow-right-line"
                  size={16}
                  class="change-arrow"
                />
                <span class="change-after">{item.after}</span>
              </div>
              <span class="change-method">{item.method}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. 螺旋 -->
  <section class="section spiral">
    <div class="container">
      <div class="spiral-content">
        <div class="spiral-visual" aria-hidden="true">
          <div class="spiral-step">
            <span class="spiral-dot"></span>
            <span>数字で見る</span>
          </div>
          <div class="spiral-step">
            <span class="spiral-dot"></span>
            <span>軸を決める</span>
          </div>
          <div class="spiral-step">
            <span class="spiral-dot"></span>
            <span>仕組みにする</span>
          </div>
        </div>
        <div class="spiral-text">
          <p>
            まず現状を数字で見る。<br />
            そこから軸を決める。<br />
            決めたことを仕組みにする。
          </p>
          <p>
            仕組みが回ると、次の課題が見えてくる。<br />
            そしてまた、数字で見る。
          </p>
          <p class="spiral-emphasis">
            この繰り返しで、会社は少しずつ強くなります。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. ABOUT -->
  <section class="section about">
    <div class="container">
      <div class="about-content">
        <p>
          人の困りごとを聞くことを仕事にしたいと思って、ずっと動いてきました。
        </p>
        <p>
          問題を一緒に考えて、解決策を形にする。<br />
          それがアプリを作ることだったり、経営の整理だったり、会計処理だったり。<br
          />
          方法はバリエーションがあります。
        </p>
        <p>
          ITを12年、会計事務所を1年やってきた結果、<br />
          そのバリエーションがだいぶ増えました。
        </p>

        <blockquote class="about-quote">
          「{profileData.story.grandfatherWords}」
        </blockquote>
        <p>
          祖父がいつも言っていた言葉です。小さな印刷会社を営んでいた祖父の会社は、デジタルの波で廃業しました。あの時何もできなかった悔しさが、今の自分の原点です。
        </p>

        <p class="about-style">
          「やめた方がいい」も言います。根拠をもって、一緒に動く。それが自分のスタイルです。
        </p>

        <a href="/profile/" class="about-link">
          もっと詳しいプロフィールを見る
          <Icon name="ri:arrow-right-line" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- 7. CTA -->
  <section class="section cta cta--dark">
    <div class="cta-inner">
      <p class="cta-desc">気になることがあれば、話してみてください。</p>
      <a href="/contact/" class="btn-primary" data-track-cta="bottom"
        >まず話してみる <Icon name="ri:arrow-right-line" size={14} /></a
      >
    </div>
  </section>

  <!-- 8. BLOG -->
  {
    latestPosts.length > 0 && (
      <section class="section blog" id="blog">
        <div class="container">
          <div class="section-header section-header--compact">
            <div class="section-label section-label--compact">Blog</div>
            <h2 class="section-title section-title--compact">最近のブログ</h2>
          </div>
          <div class="blog-cards">
            {latestPosts.map((post) => {
              const cat = getPrimaryCategory(post.category);
              return (
                <a
                  href={`/blog/${post.slug || post.id}/`}
                  class="blog-card-home"
                >
                  <div class="blog-card-home__meta">
                    <span class="blog-card-home__category">
                      <Icon name={categoryIcons[cat]} size={14} />{' '}
                      {categoryLabels[cat]}
                    </span>
                    <time
                      class="blog-card-home__date"
                      datetime={post.publishedAt}
                    >
                      {formatDate(post.publishedAt)}
                    </time>
                  </div>
                  <h3 class="blog-card-home__title">{post.title}</h3>
                </a>
              );
            })}
          </div>
          <div class="blog-more">
            <a href="/blog/" class="btn-secondary" data-track-cta="blog">
              ブログをもっと見る <Icon name="ri:arrow-right-line" size={14} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Profile card stat tooltips -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const statItems = Array.from(
        document.querySelectorAll<HTMLElement>('.profile-stats .stat-item')
      );
      if (!statItems.length) return;

      let activeItem: HTMLElement | null = null;

      const closeActive = () => {
        if (activeItem) {
          activeItem.classList.remove('stat-item--active');
          activeItem = null;
        }
      };

      statItems.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          if (activeItem === item) {
            closeActive();
            return;
          }
          closeActive();
          item.classList.add('stat-item--active');
          activeItem = item;
        });
      });

      document.addEventListener('click', () => {
        closeActive();
      });
    });
  </script>

  <!-- Problem checkbox interactions (visual toggle only, no CTA connection) -->
  <script>
    import { trackProblemClick } from '../lib/analytics';

    const problemItems =
      document.querySelectorAll<HTMLElement>('.problem-item');

    function toggleItem(el: HTMLElement) {
      const isChecked = el.getAttribute('aria-checked') === 'true';
      el.setAttribute('aria-checked', String(!isChecked));
      el.classList.toggle('problem-item--checked', !isChecked);
    }

    problemItems.forEach((el) => {
      el.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.problem-guide')) return;
        toggleItem(el);
      });

      el.addEventListener('keydown', (e) => {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          toggleItem(el);
        }
      });
    });

    // Track guide link clicks
    document
      .querySelectorAll<HTMLAnchorElement>('.problem-guide')
      .forEach((link) => {
        link.addEventListener('click', (e) => {
          e.stopPropagation();
          const item = link.closest('.problem-item');
          const text =
            item?.querySelector('.problem-text')?.textContent?.trim() || '';
          trackProblemClick(text, link.getAttribute('href') || '');
        });
      });
  </script>
</Layout>
